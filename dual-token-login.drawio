        <mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="access" target="ret">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="175" y="735" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="refresh" target="ret">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="465" y="745" />
              <mxPoint x="490" y="745" />
              <mxPoint x="490" y="790" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ret" target="end">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a1" value="Redis 角色 ①：临时状态&#xa;验证码存 login:code:{phone}&#xa;TTL 2 分钟，自动过期" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;dashed=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="620" y="100" width="210" height="90" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="JWT = header.payload.signature&#xa;签名防篡改，不防偷看&#xa;（Base64URL 是编码，不是加密）&#xa;payload 只放最小信息" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;dashed=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="620" y="480" width="210" height="100" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="Redis 角色 ②：会话开关&#xa;refresh 的 jti 登记白名单&#xa;login:refresh:{uid}:{jti}&#xa;可撤销、可轮换——补上 JWT 短板" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;dashed=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="620" y="650" width="210" height="110" as="geometry" />
        </mxCell>
        <mxCell id="a4" value="为何 access 不查 Redis？&#xa;短 TTL 本身即撤销机制&#xa;（最多活 30 分钟）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;dashed=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="480" width="130" height="110" as="geometry" />
        </mxCell>
        <mxCell id="ca1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;endArrow=none;strokeColor=#666666;exitX=0;exitY=0.44;exitDx=0;exitDy=0;entryX=1;entryY=0.17;entryDx=0;entryDy=0;" edge="1" parent="1" source="a1" target="code">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ca2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;endArrow=none;strokeColor=#666666;exitX=0;exitY=0.8;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a2" target="issue">
