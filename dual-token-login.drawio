<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="双Token登录流程" id="dual-token-login">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="start" value="开始&#xa;用户提交 手机号 + 验证码" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="200" y="20" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="code" value="校验验证码&#xa;Redis: login:code:{phone}" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="170" y="130" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="decision" value="验证码&#xa;正确？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="190" y="250" width="220" height="110" as="geometry" />
        </mxCell>
        <mxCell id="user" value="按手机号查库&#xa;不存在则创建新用户" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="170" y="420" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="issue" value="同时签发两个 Token" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="170" y="530" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="access" value="access · 30 分钟&#xa;身份自包含，本地验签&#xa;认证：无状态 · 快" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="640" width="270" height="80" as="geometry" />
        </mxCell>
        <mxCell id="refresh" value="refresh · 7 天&#xa;jti 登记进 Redis 白名单&#xa;会话：有状态 · 可撤销" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="330" y="640" width="270" height="80" as="geometry" />
        </mxCell>
        <mxCell id="ret" value="返回&#xa;access + refresh + user" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="170" y="770" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="end" value="登录态建立&#xa;请求带 access，过期用 refresh 换新" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="170" y="880" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="图例" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;verticalAlign=top;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="30" y="30" width="150" height="174" as="geometry" />
        </mxCell>
        <mxCell id="leg1" value="" style="rounded=0;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="legend">
          <mxGeometry x="10" y="30" width="30" height="16" as="geometry" />
        </mxCell>
        <mxCell id="leg1t" value="开始 / 结束" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="legend">
          <mxGeometry x="48" y="28" width="100" height="20" as="geometry" />
