server {
    listen 80;
    server_name _;
    # Windows Nginx 使用正斜杠路径，按实际目录调整盘符即可。
    root D:/1devCode/tfshz/devFE/dist;
    index index.html;

    location /api/ {
        proxy_pass http://127.0.0.1:8081/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # 图片：数据库里存的是 /imgs/blogs/...、/imgs/icons/...，由后端静态资源映射提供
    location /imgs/ {
        proxy_pass http://127.0.0.1:8081/imgs/;
        proxy_set_header Host $host;
    }

    # 分类图标：数据库存的是 /types/ms.png，实际文件在 imgs/types/ 下
    location /types/ {
        proxy_pass http://127.0.0.1:8081/imgs/types/;
        proxy_set_header Host $host;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
